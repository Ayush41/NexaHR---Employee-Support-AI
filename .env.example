APP_ENV=development
DATABASE_URL=sqlite:///./data/nexahr.db
SESSION_TTL_HOURS=12

# Local initial admin account (used only when no administrator exists yet)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Language model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Policy retrieval and external search
PINECONE_API_KEY=
PINECONE_INDEX_NAME=NexaHR_Policy-RAG
PINECONE_NAMESPACE=company-hr-kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TAVILY_API_KEY=

# Frontend URL (read by Streamlit only)
API_BASE_URL=http://127.0.0.1:8888
STREAMLIT_APP_URL=http://127.0.0.1:8501
